{
  "format": "semtalk_show_base_topology_quality_gate_spec_v1",
  "scope": "SemTalk Base on SHOW validation only",
  "split": "val",
  "test_visible": false,
  "trajectory_epochs": [
    1,
    2,
    4,
    8
  ],
  "primary_metric": "body.released2.metrics.FGD",
  "raw_prediction_replay_required": true,
  "comparison_reference": "official_w1_b64_reference",
  "measured_eta_constraint": {
    "modes": [
      "official_w1_b64_reference",
      "official_objective_w8_l8_g64_ddp_adaptation",
      "official_objective_w16_l4_g64_ddp_adaptation",
      "validation_gated_w8_l64_g512_empirical_acceleration",
      "validation_gated_w16_l32_g512_empirical_acceleration"
    ],
    "maximum_estimated_training_seconds": 86400,
    "finite_probe_required": true,
    "policy": "all_quality_safe_finite_modes_compete_by_measured_eta_under_24h"
  },
  "candidate_quality_gate": {
    "modes": [
      "official_w1_b64_reference",
      "official_objective_w8_l8_g64_ddp_adaptation",
      "official_objective_w16_l4_g64_ddp_adaptation",
      "validation_gated_w8_l64_g512_empirical_acceleration",
      "validation_gated_w16_l32_g512_empirical_acceleration"
    ],
    "per_epoch_comparison": "candidate_fgd_lte_reference_fgd_plus_max_of_absolute_or_relative_margin",
    "maximum_absolute_fgd_regression": 0.01,
    "maximum_relative_fgd_regression": 0.02,
    "all_trajectory_epochs_must_pass": true
  },
  "selection_tiebreak": [
    "estimated_training_seconds",
    "p99_seconds",
    "topology_matrix_order"
  ]
}
